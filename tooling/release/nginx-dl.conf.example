# 红葡萄分发服务 · nginx 反向代理示例
#
# 用法：把 dl.example.com 换成你的域名，放到 /etc/nginx/conf.d/hongguo-dl.conf
#       （宝塔用户：新建站点后把下面 location 段贴进「配置文件」）
#       先有证书再启用 443 段，否则 nginx 起不来：
#         certbot --nginx -d dl.example.com
#
# 两处非调不可，否则 75~80 MB 的安装包会被挡：
#   client_max_body_size 500m;        → 否则 413
#   proxy_request_buffering off;      → 否则大包先落盘中转、容易 502/504

server {
    listen 80;
    server_name dl.example.com;

    # certbot 的 http-01 校验走这里
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name dl.example.com;

    ssl_certificate     /etc/letsencrypt/live/dl.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dl.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    # 安装包体积上限，留足余量
    client_max_body_size 500m;
    client_body_timeout  300s;

    # 目录不可枚举对外的兜底（服务本身也返回 403）
    autoindex off;

    location / {
        proxy_pass         http://127.0.0.1:8099;
        proxy_http_version 1.1;

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # 边收边转，不把 80 MB 暂存在 nginx 自己身上
        proxy_request_buffering off;
        proxy_buffering         off;

        proxy_connect_timeout 15s;
        proxy_send_timeout    600s;
        proxy_read_timeout    600s;
    }
}
